import TypicalOrientations.RotationProduct
import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Analysis.Calculus.Deriv.MeanValue

namespace TypicalOrientations

open Matrix NormedSpace Set
open scoped Matrix.Norms.Operator

noncomputable section

variable {n : ℕ}

/-- The constant-speed curve of rotations generated by L. -/
def rotationExponential (L : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    Matrix (Fin n) (Fin n) ℝ :=
  NormedSpace.exp (t • L)

@[simp] theorem rotationExponential_zero (L : Matrix (Fin n) (Fin n) ℝ) :
    rotationExponential L 0 = 1 := by simp [rotationExponential]

theorem hasDerivAt_rotationExponential (L : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    HasDerivAt (rotationExponential L) (rotationExponential L t * L) t :=
  hasDerivAt_exp_smul_const L t

theorem continuous_rotationExponential (L : Matrix (Fin n) (Fin n) ℝ) :
    Continuous (rotationExponential L) :=
  Differentiable.continuous (fun t => (hasDerivAt_rotationExponential L t).differentiableAt)

theorem rotationExponential_transpose_mul (L : Matrix (Fin n) (Fin n) ℝ)
    (hL : Lᵀ = -L) (t : ℝ) :
    (rotationExponential L t)ᵀ * rotationExponential L t = 1 := by
  unfold rotationExponential
  rw [← Matrix.exp_transpose, transpose_smul, hL, smul_neg]
  have h : Commute (-(t • L)) (t • L) := (Commute.refl (t • L)).neg_left
  rw [← Matrix.exp_add_of_commute _ _ h, neg_add_cancel, NormedSpace.exp_zero]

theorem rotationExponential_det (L : Matrix (Fin n) (Fin n) ℝ)
    (hL : Lᵀ = -L) (t : ℝ) :
    (rotationExponential L t).det = 1 := by
  let f := fun t => (rotationExponential L t).det
  have hf : Continuous f := (continuous_rotationExponential L).matrix_det
  have h0 : f 0 = 1 := by simp [f]
  have hs (t : ℝ) : f t * f t = 1 := by
    have h := congrArg Matrix.det (rotationExponential_transpose_mul L hL t)
    simpa only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] using h
  rcases mul_eq_zero.mp (show (f t - 1) * (f t + 1) = 0 by nlinarith [hs t]) with h | h
  · linarith
  · have ht : f t = -1 := by linarith
    have hNeg : (-1 : ℝ) ∈ Set.range f := ⟨t, ht⟩
    have hPos : (1 : ℝ) ∈ Set.range f := ⟨0, h0⟩
    have hConn : IsPreconnected (Set.range f) := isPreconnected_range hf
    obtain ⟨s, hS⟩ := hConn.ordConnected.out hNeg hPos (show (0 : ℝ) ∈ Icc (-1) 1 by norm_num)
    nlinarith [hs s]

theorem rotationExponential_add (L : Matrix (Fin n) (Fin n) ℝ) (s t : ℝ) :
    rotationExponential L (s + t) = rotationExponential L s * rotationExponential L t := by
  rw [rotationExponential, add_smul, Matrix.exp_add_of_commute _ _
    (((Commute.refl L).smul_left s).smul_right t)]
  rfl

/-- Right multiplication by a fixed generator gives the derivative of the
right-translate curve through an ambient matrix. -/
theorem hasDerivAt_right_rotationExponential (A L : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    HasDerivAt (fun s => A * rotationExponential L s)
      ((A * rotationExponential L t) * L) t := by
  rw [Matrix.mul_assoc]
  exact (hasDerivAt_rotationExponential L t).const_mul A

theorem hasDerivAt_matrix_entry {f : ℝ → Matrix (Fin n) (Fin n) ℝ}
    {f' : Matrix (Fin n) (Fin n) ℝ} {t : ℝ} (h : HasDerivAt f f' t)
    (i j : Fin n) : HasDerivAt (fun s => f s i j) (f' i j) t := by
  let e : Matrix (Fin n) (Fin n) ℝ →ₗ[ℝ] ℝ :=
    { toFun := fun A => A i j
      map_add' := by intros; rfl
      map_smul' := by intros; rfl }
  exact e.toContinuousLinearMap.hasFDerivAt.comp_hasDerivAt t h

/-- Exponentiating a direction that vanishes on a subspace fixes every
vector of that subspace. -/
theorem rotationExponential_mul_fixed (L P : Matrix (Fin n) (Fin n) ℝ)
    (hLP : L * P = 0) (t : ℝ) :
    rotationExponential L t * P = P := by
  let f := fun s => rotationExponential L s * P
  have hf (s : ℝ) : HasDerivAt f 0 s := by
    have h : (rotationExponential L s * L) * P = 0 := by
      rw [Matrix.mul_assoc, hLP, Matrix.mul_zero]
    rw [← h]
    exact (hasDerivAt_rotationExponential L s).mul_const P
  have he := (is_const_of_deriv_eq_zero (fun s => (hf s).differentiableAt) (fun s => (hf s).deriv)) t 0
  simpa [f] using he

end

end TypicalOrientations
