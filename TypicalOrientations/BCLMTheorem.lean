import TypicalOrientations.BCLMHeatFlow
import TypicalOrientations.BCLMApproximation

namespace TypicalOrientations

open Filter Matrix MeasureTheory Set SketchOrientation
open scoped Topology

noncomputable section

variable {n d l : ℕ}

private theorem projector_fixed_by_skewRotation (P : OrthogonalProjector n l)
    (L : SkewFrobenius n) (h : skewMatrix L * P.val = 0) (s : ℝ) (U : SO n) :
    rotateProjector (U * skewRotation L s).val P = rotateProjector U.val P := by
  let R := skewRotation L s
  have hRP : R.val * P.val = P.val :=
    rotationExponential_mul_fixed (skewMatrix L) P.val h s
  have hPR : P.val * R.valᵀ = P.val := by
    have ht := congrArg Matrix.transpose hRP
    rwa [transpose_mul, P.property.1] at ht
  have hfix : R.val * P.val * R.valᵀ = P.val := by rw [hRP, hPR]
  apply Subtype.ext
  rw [rotateProjector_val _ (SO.orthogonal (U * R)), rotateProjector_val _ (SO.orthogonal U)]
  change (U.val * R.val) * P.val * (U.val * R.val)ᵀ = U.val * P.val * U.valᵀ
  calc
    _ = U.val * (R.val * P.val * R.valᵀ) * U.valᵀ := by simp only [transpose_mul, Matrix.mul_assoc]
    _ = _ := by rw [hfix]

private def heatResponse (x : soPolyL2 n d) (t : ℝ) (U : SO n) :
    SkewFrobenius n →ₗ[ℝ] ℝ where
  toFun L := soPolyCont n d (soDirectional n d L (soHeat t x)) U / heatValue x t U
  map_add' := by intro L K; simp [add_div]
  map_smul' := by
    intro a L
    simp [LinearMap.smul_apply, smul_eq_mul, mul_div_assoc]

private theorem heatResponse_zero_of_fixed (x : soPolyL2 n d)
    (P : OrthogonalProjector n l) (p : ProjectorPolynomial n)
    (hx : ∀ U, soPolyCont n d x U = evalProjectorPolynomial p (rotateProjector U.val P))
    (t : ℝ) (U : SO n) (L : SkewFrobenius n) (h : skewMatrix L * P.val = 0) :
    heatResponse x t U L = 0 := by
  have hInvariant (s : ℝ) (V : SO n) :
      soPolyCont n d x (V * skewRotation L s) = soPolyCont n d x V := by
    rw [hx, hx, projector_fixed_by_skewRotation P L h]
  have hCurve : (fun s => heatValue x t (U * skewRotation L s)) = fun _ : ℝ => heatValue x t U :=
    funext fun s => heatValue_translation_invariant (skewRotation L s) x (hInvariant s) t U
  have hd := hasDerivAt_soDirectional L (soHeat t x) U 0
  change HasDerivAt (fun s => heatValue x t (U * skewRotation L s)) _ 0 at hd
  rw [hCurve] at hd
  have hZ := hd.unique (hasDerivAt_const 0 (heatValue x t U))
  simp only [skewRotation, soExponential_zero, mul_one] at hZ
  change soPolyCont n d (soDirectional n d L (soHeat t x)) U / heatValue x t U = 0
  rw [hZ, zero_div]

set_option maxHeartbeats 1500000 in
/-- The rotation-group Brascamp–Lieb inequality for positive polynomials.
The heat flow acts on the finite-dimensional spaces generated by the
orbit polynomials, so all generator and convergence steps are finite dimensional. -/
theorem rotationBrascampLieb_polynomial_at (n m : ℕ) (rank : Fin m → ℕ) :
    RotationBrascampLiebPolynomialAt n m rank := by
  intro P c p hc hEnergy hp
  classical
  let d := Finset.univ.sup fun i : Fin m => (polynomialOrbit (P i) (p i)).totalDegree
  let x (i : Fin m) : soPolyL2 n d :=
    soPolyToL2 n d (restrictedPolynomial (polynomialOrbit (P i) (p i))
      (Finset.le_sup (f := fun a : Fin m => (polynomialOrbit (P a) (p a)).totalDegree) (Finset.mem_univ i)))
  let h (i : Fin m) (t : ℝ) (U : SO n) := heatValue (x i) t U
  let b (i : Fin m) := c i / 2
  let m0 (i : Fin m) := soPolyIntegral n d (x i)
  let φ (j : skewIndex n) (s : ℝ) (U : SO n) := U * skewRotation (skewBasis n j) s
  let D (j : skewIndex n) := soDirectional n d (skewBasis n j)
  let d₁ (j : skewIndex n) (i : Fin m) (t : ℝ) (U : SO n) :=
    soPolyCont n d (D j (soHeat t (x i))) U
  let d₂ (j : skewIndex n) (i : Fin m) (t : ℝ) (U : SO n) :=
    soPolyCont n d (D j (D j (soHeat t (x i)))) U
  have hx (i : Fin m) (U : SO n) : soPolyCont n d (x i) U =
      evalProjectorPolynomial (p i) (rotateProjector U.val (P i)) := by
    dsimp only [x]
    rw [soPolyCont_toL2, restrictedPolynomial_apply, rotationEval_polynomialOrbit]
    unfold evalProjectorPolynomial rotationEval
    rw [rotateProjector_val _ (SO.orthogonal U)]
  have hBounds (i : Fin m) : ∃ a B : ℝ, 0 < a ∧
      (∀ U, a ≤ soPolyCont n d (x i) U) ∧ (∀ U, soPolyCont n d (x i) U ≤ B) := by
    let f := soPolyCont n d (x i)
    have hU : (univ : Set (SO n)).Nonempty := ⟨1, mem_univ _⟩
    obtain ⟨U, _, hmin⟩ := isCompact_univ.exists_isMinOn hU f.continuous.continuousOn
    obtain ⟨V, _, hmax⟩ := isCompact_univ.exists_isMaxOn hU f.continuous.continuousOn
    refine ⟨f U, f V, ?_, fun W => hmin (mem_univ W), fun W => hmax (mem_univ W)⟩
    exact hx i U ▸ hp i (rotateProjector U.val (P i))
  choose a B ha haL hBU using hBounds
  have hLower (i : Fin m) (t : ℝ) (ht : 0 ≤ t) (U : SO n) : a i ≤ h i t U :=
    heatValue_lower (x i) (a i) (haL i) t ht U
  have hUpper (i : Fin m) (t : ℝ) (ht : 0 ≤ t) (U : SO n) : h i t U ≤ B i :=
    heatValue_upper (x i) (B i) (hBU i) t ht U
  have hPos (i : Fin m) (t : ℝ) (ht : 0 ≤ t) (U : SO n) : 0 < h i t U :=
    (ha i).trans_le (hLower i t ht U)
  have hZero (j : skewIndex n) (U : SO n) : φ j 0 U = U := by
    simp [φ, skewRotation]
  have hAdd (j : skewIndex n) (s t : ℝ) (U : SO n) : φ j (s+t) U = φ j s (φ j t U) := by
    unfold φ skewRotation
    rw [add_comm s t, soExponential_add, mul_assoc]
  have hΦ (j : skewIndex n) : Continuous (fun z : ℝ × SO n => φ j z.1 z.2) :=
    continuous_soExponentialAction _ _
  have hPres (j : skewIndex n) (s : ℝ) : MeasurePreserving (φ j s) (soHaar n) (soHaar n) :=
    ⟨(continuous_id.mul continuous_const).measurable, soHaar_map_mul_right _⟩
  have hJoint (i : Fin m) : Continuous (fun z : ℝ × SO n => h i z.1 z.2) :=
    continuous_heatValue (x i)
  have hJoint₁ (j : skewIndex n) (i : Fin m) :
      Continuous (fun z : ℝ × SO n => d₁ j i z.1 z.2) :=
    continuous_heatDirection (x i) (D j)
  have hJoint₂ (j : skewIndex n) (i : Fin m) :
      Continuous (fun z : ℝ × SO n => d₂ j i z.1 z.2) :=
    continuous_heatDirection (x i) ((D j).comp (D j))
  have hTime (i : Fin m) (t : ℝ) (U : SO n) :
      HasDerivAt (fun s => h i s U) (∑ j, d₂ j i t U) t := by
    have ht := hasDerivAt_heatValue (x i) U t
    change HasDerivAt _ (soPolyEvaluation U (casimir n d (soHeat t (x i)))) t at ht
    rw [casimir_apply, map_sum] at ht
    exact ht
  have hSpace₁ (j : skewIndex n) (i : Fin m) (t : ℝ) (U : SO n) :
      HasDerivAt (fun s => h i t (φ j s U)) (d₁ j i t U) 0 := by
    simpa only [skewRotation, soExponential_zero, mul_one, h, φ, heatValue, D, d₁] using
      hasDerivAt_soDirectional (skewBasis n j) (soHeat t (x i)) U 0
  have hSpace₂ (j : skewIndex n) (i : Fin m) (t : ℝ) (U : SO n) :
      HasDerivAt (fun s => d₁ j i t (φ j s U)) (d₂ j i t U) 0 := by
    simpa only [skewRotation, soExponential_zero, mul_one, φ, D, d₁, d₂] using
      hasDerivAt_soDirectional (skewBasis n j) (D j (soHeat t (x i))) U 0
  have hGradient (t : ℝ) (U : SO n) :
      (∑ j : skewIndex n, weightedLogSlope b (fun i => h i t U) (fun i => d₁ j i t U) ^ 2) ≤
        ∑ j : skewIndex n, ∑ i, b i * (d₁ j i t U / h i t U) ^ 2 := by
    exact skewDirectionalResponses_weighted_square_le_mixedRanks P c (fun i => (hc i).le) hEnergy
      (skewBasis n) (fun i => heatResponse (x i) t U)
      (fun i L hL => heatResponse_zero_of_fixed (x i) (P i) (p i) (hx i) t U L hL)
  have hMono := weightedHeatIntegral_mono (soHaar n) b h φ d₁ d₂ hPos hZero hAdd hΦ hPres
    (fun i => (hJoint i).continuousOn) (fun j i => (hJoint₁ j i).continuousOn)
    (fun j i => (hJoint₂ j i).continuousOn) (fun i t _ => hTime i t)
    (fun j i t _ => hSpace₁ j i t) (fun j i t _ => hSpace₂ j i t) (fun t _ => hGradient t)
  have hLim := weightedHeatIntegral_tendsto (soHaar n) b h B m0
    (fun i => div_nonneg (hc i).le (by norm_num))
    (fun i t _ => ((hJoint i).comp (continuous_const.prodMk continuous_id)).measurable)
    (fun i t ht U => ⟨(hPos i t ht U).le, hUpper i t ht U⟩)
    (fun i U => heatValue_tendsto (x i) U)
  have hBound := weightedHeatIntegral_le_of_mono_limit (soHaar n) b h m0 hMono hLim
  have hInitial (i : Fin m) (U : SO n) : h i 0 U =
      evalProjectorPolynomial (p i) (rotateProjector U.val (P i)) := by
    change soPolyCont n d (soHeat 0 (x i)) U = _
    rw [soHeat_zero, hx]
  have hm0 (i : Fin m) : m0 i =
      ∫ U, evalProjectorPolynomial (p i) (rotateProjector U (P i)) ∂specialOrientationLaw n := by
    change (∫ U, soPolyCont n d (x i) U ∂soHaar n) = _
    simp_rw [hx]
    exact integral_soHaar_val (fun U => evalProjectorPolynomial (p i) (rotateProjector U (P i)))
  unfold weightedPowerProduct at hBound
  simp_rw [hInitial, hm0] at hBound
  rwa [integral_soHaar_val (fun U => ∏ i, (evalProjectorPolynomial (p i) (rotateProjector U (P i))) ^ b i)]
    at hBound

/-- The bounded Borel form of (2.6) for arbitrary ranks in the same ambient space. -/
theorem rotationBrascampLieb_mixedRanks : RotationBrascampLiebMixedRanks := by
  intro n m rank hn hr
  exact rotationBrascampLieb_of_polynomial_at hn hr (rotationBrascampLieb_polynomial_at n m rank)

/-- The positive-polynomial inequality for a family of common rank. -/
theorem rotationBrascampLieb_polynomial : RotationBrascampLiebPolynomial := by
  intro n l m _ _
  exact rotationBrascampLieb_polynomial_at n m (fun _ => l)

/-- The bounded Borel inequality for a family of common rank. -/
theorem rotationBrascampLieb : RotationBrascampLieb := by
  intro n l m hn hl
  exact rotationBrascampLieb_mixedRanks n m (fun _ => l) hn (fun _ => hl)

end

end TypicalOrientations
