import Mathlib.Topology.Instances.Matrix
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real

namespace SketchOrientation

open MeasureTheory

/-- The measurable structure generated by the entries of a real matrix. -/
instance matrixMeasurableSpace (m n : Type*) : MeasurableSpace (Matrix m n ℝ) :=
  inferInstanceAs (MeasurableSpace (m → n → ℝ))

/-- On a countable matrix product, the entrywise measurable structure is Borel. -/
instance matrixBorelSpace (m n : Type*) [Countable m] [Countable n] :
    BorelSpace (Matrix m n ℝ) :=
  inferInstanceAs (BorelSpace (m → n → ℝ))

end SketchOrientation
